# TaskFlow Backend Environment Configuration
# Copy this file to .env and configure values before starting the server.

# Server Port (default: 5000)
PORT=5000

# JSON Web Token Secret
# Must be a cryptographically secure random string (minimum 32 characters in production)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# For local dev and production Render deployment:
FRONTEND_URL=http://localhost:5173,https://ai-task-manager-frontend-x3og.onrender.com

# SQLite Database File Path (optional, defaults to ./tasks.db)
DB_PATH=./tasks.db

# Environment mode (development | production | test)
NODE_ENV=development

# Google Gemini AI Integration (Official SDK)
# Obtain your key from https://aistudio.google.com/app/apikey
# Keep this exclusively on the backend; NEVER expose to frontend bundles or client responses
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini Model Selection (default: gemini-1.5-flash)
# Supported options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash
