# TaskFlow Frontend Environment Configuration
# Copy this file to .env before starting the Vite frontend development server.

# Backend API Endpoint URL
# For local development with Vite dev server proxy:
# VITE_API_URL=/api
# For production deployment on Render:
VITE_API_URL=https://ai-task-manager-backend-glq4.onrender.com/api

# Backend Turso Cloud Database Configuration (libSQL)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Backend JSON Web Token Secret
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
